{
  "name": "campusos-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node -e \"import('./src/db.js').then(m => m.connectDB()).then(() => import('./src/seed.js')).then(s => s.seedIfEmpty()).then(() => process.exit(0))\"",
    "seed:force": "node -e \"import('./src/db.js').then(m => m.connectDB()).then(() => import('./src/seed.js')).then(s => s.seedForce()).then(() => process.exit(0))\"",
    "build": "echo \"Backend is plain Node — no build step\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "openai": "^7.10.0"
  }
}
